# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env

# Which OCR engine to use.
#   mock   - deterministic stub, no credentials, always reports 48,253 (default)
#   claude - Claude vision (requires ANTHROPIC_API_KEY)
OCR_PROVIDER=mock

# Required only when OCR_PROVIDER=claude.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model id (default claude-sonnet-5). Override to try opus, etc.
ANTHROPIC_MODEL=claude-sonnet-5

# Passed to the Anthropic SDK client. Timeout is milliseconds.
# Retries are applied by the SDK on transient failures (not a custom loop).
ANTHROPIC_TIMEOUT_MS=600000
ANTHROPIC_MAX_RETRIES=2

# Maximum request body size in bytes (default 10MB).
MAX_PAYLOAD_BYTES=10485760

# Independent Claude vision calls per image (default 2). Each call is billed.
CLAUDE_SAMPLES=2

# Port the server listens on (default 3000).
PORT=3000
